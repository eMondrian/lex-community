# eMondrian Lex settings. setup.sh copies this to .env and fills in what you pass it
# (./setup.sh --help); edit .env and run ./setup.sh again to apply a change.

# The port Lex answers on, and the address it listens on (0.0.0.0: every interface;
# 127.0.0.1: this machine only).
LEX_PORT=8770
LEX_BIND=0.0.0.0

# The image version. Leave it unset to follow this repository (./setup.sh --update).
#LEX_VERSION=0.1.0

# Who the container runs as: the owner of ./base (setup.sh sets your own id -u / id -g).
LEX_UID=10001
LEX_GID=10001

# Push every change to the knowledge base to a git remote (empty: changes stay in ./base).
# Over https with a token: https://<user>:<token>@git.example.org/team/knowledge.git
# Over ssh: git@git.example.org:team/knowledge.git, with LEX_SSH_DIR a directory holding the
# key (id_ed25519) and known_hosts; it is mounted read-only.
LEX_GIT_REMOTE=
LEX_GIT_BRANCH=
#LEX_SSH_DIR=/home/me/.lex-ssh

# The author of the commits Lex makes.
LEX_GIT_NAME=Lex
LEX_GIT_EMAIL=lex@localhost

# TLS: a public name that points at this machine. Set, setup.sh starts Caddy in front
# (ports 80 and 443) and Lex is at https://<LEX_DOMAIN>/.
LEX_DOMAIN=

# Regenerate stale pages when a page is opened (1), instead of offering a button.
LEX_AUTO_REGENERATE=
LEX_LOG_LEVEL=info
